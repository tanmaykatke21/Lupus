# Copy this file to .env.local and fill in values. Never commit .env.local.

# Gemini API key from Google AI Studio. Not needed yet; used by the trip agent and schedule import.
GEMINI_API_KEY=

# "live" (default) reads ETA Spot. "sample" always serves data/samples/vehicles-1235.json,
# useful for offline demos or when buses aren't running.
ETASPOT_MODE=live
