# Copy to .env.local and fill in. Never commit real keys.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GEMINI_API_KEY=
# Tiger Data (TimescaleDB) connection string, e.g. postgres://tsdbadmin:...@xxxx.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require
DATABASE_URL=
# Google Maps JavaScript API (browser key: restrict it to your domains in Cloud Console).
# Without it the app uses the free MapLibre/OpenFreeMap map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: your own Map ID (Cloud Console → Map Management) for custom styling. Defaults to DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAP_ID=
