# Copy this file to .env.local and fill in values. Never commit .env.local.

# Gemini API key from Google AI Studio. Used by Ask Lupus (and schedule import, coming next).
GEMINI_API_KEY=
# Optional: which Gemini model to use (default gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash
# Optional: "mock" answers Ask Lupus offline without Gemini, labeled as demo mode in the app.
# AGENT_MODE=mock

# "live" (default) reads ETA Spot. "sample" always serves data/samples/vehicles-1430-eta.json,
# useful for offline demos or when buses aren't running.
ETASPOT_MODE=live
